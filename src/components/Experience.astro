---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Abr. 2025 - Presente",
    dateEn: "Apr 2025 - Present",
    titleEs: "Full Stack Developer",
    titleEn: "Full Stack Developer",
    company: "Canella, S.A.",
    descriptionEs: "Migración de productos legacy (C#/ASP.NET antiguo) a .NET 8 para sistemas de un banco líder en Guatemala, modernizando código crítico en un entorno de alta disponibilidad. Despliegue y mantenimiento de servicios containerizados con Docker, Kubernetes y OpenShift. Flujos de CI/CD con Azure DevOps y GitHub, integrando herramientas de IA en el desarrollo diario.",
    descriptionEn: "Migrated legacy C#/ASP.NET products to .NET 8 for a leading Guatemalan bank, modernizing critical code in a high-availability environment. Deployed and maintained containerized services with Docker, Kubernetes and OpenShift. Built CI/CD workflows with Azure DevOps and GitHub, integrating AI-assisted tools into daily development.",
  },
  {
    date: "Ene. 2023 - Mar. 2025",
    dateEn: "Jan 2023 - Mar 2025",
    titleEs: "Freelance Full Stack Engineer",
    titleEn: "Freelance Full Stack Engineer",
    company: "Freelance",
    descriptionEs: "Diseño e implementación de sistemas web completos para distintos clientes, incluyendo un sistema integral de gestión de lotificaciones. Backend con Node.js y MongoDB, frontend responsivo en React. Gestión del ciclo de vida completo del software, desde el levantamiento de requerimientos hasta el despliegue.",
    descriptionEn: "Designed and built full web systems for various clients, including a comprehensive land-lot management system. Node.js + MongoDB backend, responsive React frontend. Managed the full software lifecycle, from requirements gathering to deployment.",
  },
  {
    date: "2019 - 2022",
    titleEs: "Experiencia previa: producción audiovisual y educación técnica",
    titleEn: "Prior experience: audiovisual production & technical education",
    company: "Freelance / Unción TV / Liceo Nuevo Milenio",
    descriptionEs: "Diseño publicitario, coordinación tecnológica de un canal de TV, e instrucción de programación y lógica computacional.",
    descriptionEn: "Advertising design, technology coordination for a TV channel, and programming and computational logic instruction.",
  },
];
---

<ol class="relative mt-8 space-y-6">
  {EXPERIENCE.map((exp) => (
    <li>
      <ExperienceItem
        title={exp.titleEs}
        titleEn={exp.titleEn}
        company={exp.company}
        date={exp.date}
        dateEn={exp.dateEn}
        description={exp.descriptionEs}
        descriptionEn={exp.descriptionEn}
      />
    </li>
  ))}
</ol>
