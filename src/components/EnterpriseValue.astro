---

<div class="space-y-8">
  <!-- Intro highlight -->
  <div class="p-5 rounded-2xl bg-gradient-to-r from-violet-50 to-blue-50 dark:from-violet-900/20 dark:to-blue-900/20 border border-violet-200/60 dark:border-violet-700/40">
    <p class="i18n-es-block text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed">
      La combinación de <strong class="text-violet-600 dark:text-violet-400">desarrollo .NET en el sector financiero</strong>,
      <strong class="text-red-600 dark:text-red-400"> seguridad informática aplicada</strong> y
      <strong class="text-cyan-600 dark:text-cyan-400"> cloud-native deployment</strong>
      es un perfil raro y de alto valor para empresas fintech y proyectos de transformación tecnológica.
    </p>
    <p class="i18n-en-block text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed">
      The combination of <strong class="text-violet-600 dark:text-violet-400">.NET development in the financial sector</strong>,
      <strong class="text-red-600 dark:text-red-400"> applied information security</strong> and
      <strong class="text-cyan-600 dark:text-cyan-400"> cloud-native deployment</strong>
      is a rare, high-value profile for fintech companies and tech transformation projects.
    </p>
  </div>

  <!-- Cards -->
  <div class="grid gap-4 sm:grid-cols-2">
    {VALUE_PROPS.map(({ emoji, titleEs, titleEn, descEs, descEn, colorClass }) => (
      <div class={`flex gap-4 p-5 rounded-2xl border transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 ${colorClass}`}>
        <span class="text-2xl flex-shrink-0 mt-0.5">{emoji}</span>
        <div>
          <h4 class="font-semibold text-gray-900 dark:text-white text-sm sm:text-base mb-1">
            <span class="i18n-es">{titleEs}</span>
            <span class="i18n-en">{titleEn}</span>
          </h4>
          <p class="i18n-es-block text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{descEs}</p>
          <p class="i18n-en-block text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{descEn}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom highlights -->
  <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
    <span class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span class="i18n-es">Disponible para proyectos internacionales</span>
      <span class="i18n-en">Available for international projects</span>
    </span>
    <span class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <svg class="w-4 h-4 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span class="i18n-es">Inglés avanzado (C1)</span>
      <span class="i18n-en">Advanced English (C1)</span>
    </span>
    <span class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span class="i18n-es">Maestría en Seguridad en curso</span>
      <span class="i18n-en">Master's in Security (in progress)</span>
    </span>
  </div>
