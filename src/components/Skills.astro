---
// Categories render in pairs in the 2-column grid, so keep an even count and put related ones side by side.
// A skill is a plain string when its name is the same in both languages, or { es, en } when it is not.
type Skill = string | { es: string; en: string }

const SKILL_CATEGORIES: { titleEs: string; titleEn: string; icon: string; headerClass: string; bgClass: string; badgeClass: string; skills: Skill[] }[] = [
  {
    titleEs: ".NET & Backend",      titleEn: ".NET & Backend",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    headerClass: "text-violet-600 dark:text-violet-400",
    bgClass:     "bg-violet-50 dark:bg-violet-900/20 border-violet-200 dark:border-violet-800",
    badgeClass:  "bg-violet-100 dark:bg-violet-900/40 text-violet-800 dark:text-violet-200 border border-violet-200 dark:border-violet-700",
    skills: ["C#", ".NET 8", "ASP.NET Core", "Entity Framework Core", ".NET Framework → .NET 8", "Python", "FastAPI", "Node.js", "Go", "REST APIs", "Hexagonal Architecture", "RabbitMQ"],
