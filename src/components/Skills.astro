  },
  {
    titleEs: "Metodologías & Herramientas", titleEn: "Methodologies & Tools",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>`,
    headerClass: "text-amber-600 dark:text-amber-400",
    bgClass:     "bg-amber-50 dark:bg-amber-900/20 border-amber-200 dark:border-amber-800",
    badgeClass:  "bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-200 border border-amber-200 dark:border-amber-700",
    skills: ["Scrum / Agile", "Git", "GitHub", "Technical Documentation (ADRs)", "GRC", "Defense-in-Depth", { es: "Auditoría de Sistemas", en: "Systems Auditing" }],
  },
]
---

<div class="grid gap-5 sm:grid-cols-2">
  {SKILL_CATEGORIES.map((cat) => (
    <div class={`p-5 rounded-2xl border transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ${cat.bgClass}`}>
      <h3 class={`flex items-center gap-2 text-base font-bold mb-4 ${cat.headerClass}`}>
        <span set:html={cat.icon} />
        <span class="i18n-es">{cat.titleEs}</span>
        <span class="i18n-en">{cat.titleEn}</span>
      </h3>
      <div class="flex flex-wrap gap-2">
        {cat.skills.map((skill) => (
          <span class={`rounded-lg px-2.5 py-1 text-xs font-medium transition-all duration-200 hover:scale-105 ${cat.badgeClass}`}>
            {typeof skill === "string" ? skill : (
              <>
                <span class="i18n-es">{skill.es}</span>
                <span class="i18n-en">{skill.en}</span>
              </>
            )}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
